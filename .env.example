# Copy to `.env` or `apps/backend/.env` as needed.
# Never commit real RASEN_API_KEY values.

RASEN_API_BASE=https://api.rasen.ai/v1
RASEN_API_KEY=
RASEN_TRANSPORT=fake
DATABASE_URL=sqlite:///./rasenloop.db
PUBLIC_BASE_URL=http://localhost:8000
# Tunnel examples for live Rasen webhooks / MCP:
# PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
# MCP_PUBLIC_URL=https://xxxx.ngrok-free.app/mcp
MCP_PUBLIC_URL=http://localhost:8001/mcp
WEBHOOK_SIGNING_SECRET=whsec_dev_replace_me
MCP_AUTH_TOKEN=mcp-dev-token
WAR_ROOM_PASSWORD=dev
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WAR_ROOM_PASSWORD=dev
CONTROL_PLANE_AUTO_EVAL=true
CHAOS_MODE=false
REFUND_SECRET_ID=
REFUND_SECRET_VERSION=1
AGENT_ID=
PRE_CALL_DEADLINE_MS=800
PRECALL_API_KEY=demo-precall-key
